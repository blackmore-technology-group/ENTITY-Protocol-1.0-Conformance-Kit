{
  "$id": "domain.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "btg_host_required": {
      "const": false
    },
    "created_at_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "dns_required": {
      "const": false
    },
    "domain_id": {
      "pattern": "^domain1-[0-9a-f]{40}$",
      "type": "string"
    },
    "entity_root": {
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$",
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "registrar_required": {
      "const": false
    },
    "schema": {
      "const": "entity-domain-v1"
    },
    "status": {
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "domain_id",
    "entity_root",
    "namespace",
    "version",
    "status",
    "created_at_ms"
  ],
  "type": "object"
}
