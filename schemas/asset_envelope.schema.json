{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset_envelope.schema.json",
  "type": "object",
  "required": [
    "schema",
    "application_entity_id",
    "asset_controller_entity_id",
    "idempotency_key",
    "content_sha256",
    "size_bytes",
    "media_type",
    "title",
    "asset_kind",
    "raw_content_included"
  ],
  "properties": {
    "schema": {
      "const": "entity-open-sdk-asset-envelope-v1.1"
    },
    "application_entity_id": {
      "type": "string",
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$"
    },
    "asset_controller_entity_id": {
      "type": "string",
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$"
    },
    "installation_entity_id": {
      "type": "string",
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$"
    },
    "device_entity_id": {
      "type": "string",
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "asset_kind": {
      "enum": [
        "SOFTWARE",
        "DATA",
        "MODEL",
        "KNOWLEDGE",
        "EVIDENCE"
      ]
    },
    "classification": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "source_subject_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "explicit_rights_claim": {
      "type": "object"
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parent_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_content_included": {
      "const": false
    }
  },
  "additionalProperties": true
}
