{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entity_identity.schema.json",
  "type": "object",
  "required": [
    "schema",
    "entity_id",
    "entity_type",
    "display_name",
    "aliases",
    "metadata",
    "verification_methods",
    "active_signing_key_id",
    "recovery_policy",
    "crypto_agility",
    "created_at_ms",
    "manifest_revision",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "sovereign-entity-manifest-v2"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(ent1|ent2)-[a-z2-7]{52}$"
    },
    "entity_type": {
      "enum": [
        "person",
        "family",
        "business",
        "product",
        "application",
        "system",
        "community",
        "service",
        "organization",
        "project"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    },
    "active_signing_key_id": {
      "type": "string"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "verification_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "algorithm",
          "suite",
          "purpose",
          "public_key",
          "status",
          "created_at_ms"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "suite": {
            "const": "ENTITY-SIG-ED25519-v1"
          },
          "purpose": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "public_key": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          },
          "created_at_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "recovery_policy": {
      "type": "object"
    },
    "crypto_agility": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "required": [
        "key_id",
        "suite",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string"
        },
        "suite": {
          "const": "ENTITY-SIG-ED25519-v1"
        },
        "signature": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
